# App: the local Supabase stack (pnpm supabase start). Storage keys come from pnpm supabase status.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/amagi_cbhs
PAYLOAD_SECRET=
S3_BUCKET=media
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Test mode (SPEC §11.1). Leave unset everywhere until launch; production sets SITE_LIVE=true at launch.
SITE_LIVE=

# Site origin, no trailing slash. Stripe redirects back to it after Checkout.
# Unset on Netlify: it falls back to Netlify's $URL, the site's primary URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Stripe key: test (sk_test_… or rk_test_…) locally, live in production from the start (SPEC §11.1).
STRIPE_SECRET_KEY=

# pnpm db:pull only: production, read from and never written to.
# The session pooler (port 5432 on the pooler host) suits pg_dump better than the transaction pooler.
PULL_DATABASE_URL=
PULL_S3_BUCKET=media
PULL_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
PULL_S3_REGION=
PULL_S3_ACCESS_KEY_ID=
PULL_S3_SECRET_ACCESS_KEY=

# Airtable (SPEC §9.1): personal access token scoped to the CBHS base
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Email (SPEC §9.2): Resend key, a full address on the verified domain, and where test-mode email and sync alerts go
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_SANDBOX_TO=
SYNC_ALERT_TO=
